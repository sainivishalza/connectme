# Copy to .env and fill in. Never commit .env.
# Server
PORT=8080
# development or test turn on the local conveniences below. ANYTHING else, including a
# missing ENV, is treated as PRODUCTION and runs every launch check.
ENV=development
APP_ALLOWED_ORIGINS=http://localhost:3000
# Load balancer / ingress addresses. X-Forwarded-For is trusted ONLY from these peers
# (leave empty when the API is reached directly). Required for correct per-IP rate limits behind a proxy.
# REQUIRED in production: the load balancers' CIDRs (X-Forwarded-For is trusted only from them),
# or "none" if the API is reached directly. Left unset, production refuses to start.
# TRUSTED_PROXY_CIDRS=10.0.0.0/8

# PostgreSQL (PostGIS)
POSTGRES_USER=connectme
POSTGRES_PASSWORD=
POSTGRES_DB=connectme
POSTGRES_URL=postgres://connectme:<password>@localhost:5432/connectme?sslmode=disable

# Redis
REDIS_PASSWORD=
REDIS_URL=redis://:<password>@localhost:6379

# MongoDB (chat ciphertext only)
MONGO_USER=connectme
MONGO_PASSWORD=
MONGO_URL=mongodb://connectme:<password>@localhost:27017/connectme?authSource=admin

# JWT (server refuses to start if < 32 bytes or left as placeholder)
JWT_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# Realtime (Node Socket.io)
REALTIME_PORT=3001

# Stripe (test keys only in development)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Return URLs are fixed server-side (never taken from clients). Use app deep links or https URLs.
CHECKOUT_SUCCESS_URL=connectme://payments/success
CHECKOUT_CANCEL_URL=connectme://payments/cancel
# Only change for tests / proxies:
# STRIPE_API_BASE=https://api.stripe.com

# CSAM image scanning (and AWS credentials for providers that need them)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# stub = accepts every image, development and test only. Production refuses to start with
# it, and also refuses until a real provider adapter exists (docs/CSAM_RUNBOOK.md).
CSAM_PROVIDER=stub

# AI service (scoring, moderation, wingman). Shared secret between the API and the service.
# Generate with: openssl rand -hex 32
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_KEY=
# Content moderation FAILS CLOSED: if the AI service is down, slow or not configured,
# bios, names, notes, comments and photos are refused with 503 moderation_unavailable.
# Development only: let content through unchecked when the AI service is not running.
# Production refuses to start with this set.
MODERATION_DEV_BYPASS=false
# How long a moderation call may take before the content is refused (milliseconds).
AI_TEXT_TIMEOUT_MS=2000
AI_IMAGE_TIMEOUT_MS=6000
# Optional operator lists for the AI service:
# MODERATION_EXTRA_BLOCKLIST=/path/words.txt
# IMAGE_HASH_BLOCKLIST=/path/hashes.txt

# Push notifications. stub = nothing leaves the process; fcm = Firebase Cloud Messaging.
PUSH_PROVIDER=stub
FCM_PROJECT_ID=
# Path to a service-account JSON key (mount as a secret).
FIREBASE_CREDENTIALS=

# Live streaming (LiveKit). Leave LIVEKIT_URL empty to disable /live.
# The secret must be at least 32 bytes.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

# Short videos and profile reels. OFF by default: there is no video abuse/CSAM
# provider behind them yet (docs/AUDIT.md 3.10); production needs VIDEO_SCANNER=http.
ENABLE_VIDEO=false
# stub (allows everything: development only) or http (production). The http scanner
# receives each clip and must answer {"action":"allow|flag|block","reason":"..."}.
# Image/video nudity screening (ai-service). Path to an ONNX model made by
# ai-service/tools/export_nsfw_onnx.py. Set but unloadable = the service will not start.
# NSFW_MODEL_PATH=models/nsfw.onnx
# VIOLENCE_MODEL_PATH=models/violence.onnx   # tools/export_violence_onnx.py; sends images to HUMAN REVIEW only
# VIOLENCE_LABELS=nonviolence,violence      # class order is undocumented: check with tools/check_violence_labels.py
# VIOLENCE_REVIEW=0.7  VIOLENCE_BLOCK=1.01  # a violence score never blocks unless you lower VIOLENCE_BLOCK
# The bundled scanner: VIDEO_SCANNER=http, VIDEO_SCANNER_URL=http://ai-service:8000/moderate/video,
# VIDEO_SCANNER_KEY=<the AI_SERVICE_KEY>. It needs NSFW_MODEL_PATH, otherwise it answers 503 and clips are held.
VIDEO_SCANNER=stub
VIDEO_SCANNER_URL=
VIDEO_SCANNER_KEY=

# AI wingman for group dates (read by the ai-service). template = built-in suggestions;
# llm = ask a language model, falling back to templates on any problem.
WINGMAN_PROVIDER=template
ANTHROPIC_API_KEY=
WINGMAN_MODEL=claude-sonnet-5-5
WINGMAN_LLM_RPM=30

# Prometheus /metrics: a PRIVATE listener, never exposed through the public API. Empty disables.
METRICS_ADDR=127.0.0.1:9464
# GIFs in chat: builtin (generated animated stickers, no key), tenor (needs TENOR_API_KEY) or none.
GIF_PROVIDER=builtin
TENOR_API_KEY=
# Error reporting to Sentry (or GlitchTip): https://<public-key>@<host>/<project-id>. Empty disables.
# Events carry the scrubbed error text, our stack and the route pattern only (pkg/errtrack).
SENTRY_DSN=

# Email delivery (any SMTP relay: SES, SendGrid, Postmark...). Required in production.
# Leave SMTP_HOST empty in development: emails are logged instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=ConnectMe <no-reply@example.com>
# SMTP_ALLOW_PLAINTEXT=true   # local test relays (MailHog) only; refused in production

# Object storage for photos and chat attachments (S3 API: AWS S3, R2, Spaces, SeaweedFS...).
# Leave S3_ENDPOINT empty to keep media on local disk (MEDIA_DIR), fine for a single node.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
S3_USE_SSL=true
# S3_SSE=true     # ask for server-side encryption where the store supports it

# Public ownership board and investor pledges. Keep OFF until a lawyer has approved
# how equity is offered in your country (see docs/DECISIONS.md 183).
ENABLE_INVESTORS=false
INVESTOR_OWNER_NAME=Vishal Saini
INVESTOR_PAYMENT_NOTE=

# Text-message alerts to trusted contacts (leave empty in development: texts are only logged).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
